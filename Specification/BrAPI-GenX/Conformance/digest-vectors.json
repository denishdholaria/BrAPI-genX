    {
      "id": "integer-outside-safe-interoperability-range",
      "inputJson": "{\"value\":9007199254740993}",
      "reasonClass": "candidate-profile-hardening",
      "reason": "Additional strict-profile policy, not a claim that JSON syntax is invalid: reject this plain-integer token before JavaScript parsing can round it. RFC 7493 warns that integer values above 9007199254740991 are not guaranteed to be treated exactly; exact values should use a schema-defined string representation."
    }
  ]
